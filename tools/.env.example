# Секреты для ручной настройки через config.toml (окну OpsDigest этот файл не нужен). Файл .env не попадает в git.

# my.telegram.org → API development tools → App api_id / App api_hash
TG_API_ID=
TG_API_HASH=
TG_PHONE=+7

# Прокси для Telegram. Несколько — через пробел или запятую.
# MTProxy: tg://proxy?server=...&port=...&secret=...   SOCKS5: socks5://user:pass@host:port
TG_PROXY=

# Корпоративный агент (если будет API)
MAVERICK_URL=
MAVERICK_TOKEN=

# Claude API (по желанию)
ANTHROPIC_API_KEY=
